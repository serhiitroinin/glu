#!/usr/bin/env bash
# Demo wrapper — dispatches to fixture files so the GIF can be regenerated
# without auth or live API calls. Real CLI lives at ../dist/glu.
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
F="$DIR/fixtures"

case "${1:-}" in
  ""|--help|-h)        cat "$F/help.txt" ;;
  --version|-V)        echo "0.4.0" ;;
  current)             cat "$F/current.txt" ;;
  graph)               cat "$F/graph.txt" ;;
  tir)                 cat "$F/tir.txt" ;;
  overview)            cat "$F/overview.txt" ;;
  status)              echo "Not logged in. Run: glu login" ;;
  *) echo "demo: unknown subcommand: $1" >&2; exit 1 ;;
esac
